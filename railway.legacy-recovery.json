{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.legacy-recovery"
  },
  "deploy": {
    "startCommand": "python3 cloud_entry.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "always"
  }
}
