[Unit]
Description=ARGOS vision accelerator (Coral Edge TPU)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/dev/apex_0

[Service]
Type=simple
User=argos-vision
Group=argos-vision
SupplementaryGroups=apex
EnvironmentFile=/etc/argos/vision-accel.env
WorkingDirectory=/opt/argos-vision/app
ExecStart=/opt/argos-vision/venv/bin/python /opt/argos-vision/app/coral_accel_server.py
Restart=on-failure
RestartSec=5

# Кадры только в памяти; сервису нужны /dev/apex_0, модели и ключ.
DevicePolicy=closed
DeviceAllow=/dev/apex_0 rw
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/argos-vision/models /etc/argos
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
